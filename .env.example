# ==============================================================================
# TerraQuest AI — Environment Variables Configuration
# ==============================================================================
# Challenge: Hacktoberfest 2026 Week 1 (Touch Grass)
# Note: Never commit real API keys to source control.
# Copy this file to .env.local for local development.
# ==============================================================================

# Google AI Studio API Key (optional for development; if omitted, the app runs
# completely in deterministic Curated Activity Fallback mode).
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here

# Configured AI Model:
# Preferred open-weight instruction models via Google AI Studio:
# - gemma-2-9b-it (recommended standard)
# - gemma-2-27b-it
# - gemma-3-12b-it (when available to account)
# Fallback closed models (if Gemma is not available in account):
# - gemini-2.5-flash
AI_MODEL=gemma-2-9b-it

# AI Provider adapter:
# Options: 'google' | 'curated'
# Default: 'google'
AI_PROVIDER=google
